{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Potential change order: structured draft",
  "description": "Step 1 of the drafting pipeline (design section 7). The draft proposes; code prices it. Anything not known is an explicit unknown field with a question, never a missing value or a guess.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definition",
    "header",
    "description",
    "reason",
    "scope",
    "clarifications_and_exclusions",
    "pricing_basis",
    "nte_amount",
    "cost_lines",
    "schedule",
    "attachments",
    "open_questions",
    "contract_terms",
    "markup_presentation",
    "architect_signs",
    "signatures"
  ],
  "properties": {
    "definition": {
      "const": "CHG-53-DEF"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pco_number",
        "date",
        "project",
        "project_address",
        "owner",
        "contract_reference",
        "location",
        "trades",
        "change_event_ref",
        "requested_approval_date",
        "cause_category"
      ],
      "properties": {
        "pco_number": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "project": {
          "$ref": "#/$defs/text"
        },
        "project_address": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "contract_reference": {
          "$ref": "#/$defs/text"
        },
        "location": {
          "$ref": "#/$defs/text"
        },
        "trades": {
          "$ref": "#/$defs/text_list"
        },
        "change_event_ref": {
          "$ref": "#/$defs/text"
        },
        "requested_approval_date": {
          "$ref": "#/$defs/date"
        },
        "cause_category": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "reason": {
      "$ref": "#/$defs/text"
    },
    "request_record": {
      "$ref": "#/$defs/text",
      "description": "How the Owner's request arrived (email or meeting, and its date). Optional; when unknown the PCO shows a bracketed blank."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inclusions",
        "deleted_scope",
        "assumptions"
      ],
      "properties": {
        "inclusions": {
          "$ref": "#/$defs/text_list"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deleted_scope": {
          "$ref": "#/$defs/text_list",
          "description": "Known and empty means None."
        }
      }
    },
    "pricing_basis": {
      "enum": [
        "lump_sum",
        "T&M",
        "CCD"
      ]
    },
    "nte_amount": {
      "$ref": "#/$defs/number"
    },
    "cost_lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cost_line"
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_days",
        "contract_duration_days",
        "critical_path",
        "completion_date",
        "authorization_by"
      ],
      "properties": {
        "extension_days": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "contract_duration_days": {
          "$ref": "#/$defs/nonnegative_number"
        },
        "critical_path": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "value"
              ],
              "properties": {
                "status": {
                  "const": "known"
                },
                "value": {
                  "enum": [
                    "yes",
                    "no"
                  ]
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "completion_date": {
          "$ref": "#/$defs/text"
        },
        "authorization_by": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "letter",
          "description"
        ],
        "properties": {
          "letter": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "supplied": {
            "type": "boolean",
            "description": "True only when the file was actually supplied. Never checked otherwise."
          },
          "kind": {
            "enum": [
              "drawing",
              "quote",
              "correspondence",
              "other"
            ]
          }
        }
      }
    },
    "backup": {
      "description": "Pricing backup and records filed with the PCO in the job folder (CHG-53 2). Never printed as exhibits; a contract that requires backup with a change is a step 6 term.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "quote",
              "correspondence",
              "selection",
              "takeoff",
              "tm_log",
              "photo",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "internal_notes": {
      "description": "Notes for the PM (how something was estimated, what a quote covers). Never printed on the Owner's PCO.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "markup_presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "reference"
      ],
      "properties": {
        "value": {
          "enum": [
            "itemized",
            "combined",
            "hidden"
          ]
        },
        "source": {
          "enum": [
            "company_setting",
            "contract_term"
          ]
        },
        "reference": {
          "$ref": "#/$defs/text"
        }
      },
      "if": {
        "properties": {
          "source": {
            "const": "contract_term"
          }
        }
      },
      "then": {
        "properties": {
          "reference": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "value"
            ]
          }
        }
      }
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "enum": [
              "executive_cosign",
              "client",
              "contractor_pm"
            ]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "contract_terms": {
      "description": "Pricing terms from a supplied contract. A clear term replaces the company value for this request and is cited (design section 6).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reference",
            "markup",
            "pass_through"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "markup": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "rate",
                  "applies_to"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "applies_to": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "all",
                        "labor",
                        "materials",
                        "subcontractors",
                        "equipment",
                        "general_conditions"
                      ]
                    }
                  }
                }
              }
            },
            "pass_through": {
              "type": "array",
              "items": {
                "enum": [
                  "permits_and_fees",
                  "labor",
                  "materials",
                  "subcontractors",
                  "equipment",
                  "general_conditions"
                ]
              }
            }
          }
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "repeat_client": {
      "$ref": "#/$defs/boolean",
      "description": "Whether the client is a repeat client. Read only when the company enables REPEAT-CLIENT-DISCOUNT."
    },
    "clarifications_and_exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/clarification"
      }
    },
    "architect_signs": {
      "description": "Set from a supplied contract term or the PM. Unknown when neither says; the PCO then carries the architect's line, marked for the PM to keep or delete.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "reference"
          ],
          "properties": {
            "value": {
              "type": "boolean"
            },
            "source": {
              "enum": [
                "contract_term",
                "pm"
              ]
            },
            "reference": {
              "$ref": "#/$defs/text"
            }
          },
          "if": {
            "properties": {
              "source": {
                "const": "contract_term"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "properties": {
                  "status": {
                    "const": "known"
                  }
                },
                "required": [
                  "value"
                ]
              }
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    }
  },
  "$defs": {
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "question"
      ],
      "properties": {
        "status": {
          "const": "unknown"
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "not_applicable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "date": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "text_list": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "nonnegative_number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reference",
        "date"
      ],
      "properties": {
        "source": {
          "enum": [
            "rate_table",
            "supplied_quote",
            "pm_notes",
            "historical_record",
            "estimate"
          ]
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "cost_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "trade",
        "division",
        "description",
        "quantity",
        "unit",
        "unit_price",
        "basis",
        "evidence",
        "attachment",
        "permit"
      ],
      "properties": {
        "category": {
          "enum": [
            "labor",
            "materials",
            "subcontractors",
            "equipment",
            "general_conditions",
            "permits_and_fees"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "The rate table role this line is priced at (labor and general conditions). Matched exactly; a line without one gets no table rate."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/number"
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "unit_price": {
          "$ref": "#/$defs/number"
        },
        "basis": {
          "enum": [
            "hours_x_rate",
            "quote",
            "estimate",
            "rate_x_duration",
            "weeks_x_rate",
            "actual_fee"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "trade": {
          "type": "string",
          "minLength": 1
        },
        "division": {
          "$ref": "#/$defs/division"
        },
        "attachment": {
          "$ref": "#/$defs/text"
        },
        "permit": {
          "enum": [
            "included_in_quote",
            "excluded",
            "not_stated",
            "not_applicable"
          ]
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "trades",
        "disposition",
        "text"
      ],
      "properties": {
        "prompt": {
          "enum": [
            "concealed_conditions",
            "finish_limited",
            "owner_upgrades",
            "permits",
            "hazardous_materials",
            "other"
          ]
        },
        "trades": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The trades this covers, or [\"all\"]."
        },
        "disposition": {
          "enum": [
            "clarified",
            "excluded",
            "not_applicable",
            "open_question"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "division": {
      "description": "2-digit MasterFormat division.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "enum": [
                "00",
                "01",
                "02",
                "03",
                "04",
                "05",
                "06",
                "07",
                "08",
                "09",
                "10",
                "11",
                "12",
                "13",
                "14",
                "21",
                "22",
                "23",
                "25",
                "26",
                "27",
                "28",
                "31",
                "32",
                "33",
                "34",
                "35",
                "40",
                "41",
                "42",
                "43",
                "44",
                "45",
                "46",
                "48"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "boolean": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "selection": {
      "description": "An Owner selection (PRO-34) covering items on this line. Referenced by ID; never attached.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "status",
        "id",
        "date"
      ],
      "properties": {
        "items": {
          "type": "string",
          "minLength": 1,
          "description": "What the selection covers, e.g. 'Fixtures and trims'."
        },
        "status": {
          "enum": [
            "approved",
            "approved_as_noted",
            "issued_with_pco",
            "pending",
            "revised",
            "unknown"
          ]
        },
        "id": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "$ref": "#/$defs/date"
        }
      }
    }
  }
}
